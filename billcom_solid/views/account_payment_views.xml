<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_payment_form_billcom_solid" model="ir.ui.view">
        <field name="name">account.payment.form.billcom.solid</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="billcom.view_account_payment_form_billcom"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_sync_bill_pay_to_billcom"
                        string="Sync Bill + Pay"
                        type="object"
                        class="oe_highlight"
                        attrs="{'invisible': ['|', '|', ('payment_type', '!=', 'outbound'), ('partner_type', '!=', 'supplier'), ('state', '!=', 'posted')] }"
                        groups="account.group_account_invoice"/>
            </xpath>

            <xpath expr="//sheet" position="inside">
                <group string="Bill.com Solid Flow"
                       attrs="{'invisible': ['|', ('payment_type', '!=', 'outbound'), ('partner_type', '!=', 'supplier')]}">
                    <field name="billcom_solid_approver_ids"
                           readonly="1"
                           placeholder="Auto-filled from active Bill.com approvers"/>
                    <field name="billcom_solid_bill_id" readonly="1" attrs="{'invisible': [('billcom_solid_bill_id', '=', False)]}"/>
                    <field name="billcom_solid_approval_status" readonly="1" attrs="{'invisible': [('billcom_solid_bill_id', '=', False)]}"/>
                    <field name="billcom_solid_sync_date" readonly="1" attrs="{'invisible': [('billcom_solid_sync_date', '=', False)]}"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
