<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_barcode_photo_tree" model="ir.ui.view">
        <field name="name">stock.barcode.photo.tree</field>
        <field name="model">stock.barcode.photo</field>
        <field name="arch" type="xml">
            <tree>
                <field name="create_date"/>
                <field name="picking_id"/>
                <field name="product_id"/>
                <field name="note"/>
            </tree>
        </field>
    </record>

    <record id="view_stock_barcode_photo_form" model="ir.ui.view">
        <field name="name">stock.barcode.photo.form</field>
        <field name="model">stock.barcode.photo</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="move_line_id"/>
                        <field name="picking_id" readonly="1"/>
                        <field name="product_id" readonly="1"/>
                        <field name="note"/>
                        <field name="image_1920" widget="image"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_stock_picking_photo_tree" model="ir.ui.view">
        <field name="name">stock.picking.photo.tree</field>
        <field name="model">stock.picking.photo</field>
        <field name="arch" type="xml">
            <tree>
                <field name="create_date"/>
                <field name="picking_id"/>
                <field name="note"/>
            </tree>
        </field>
    </record>

    <record id="view_stock_picking_photo_form" model="ir.ui.view">
        <field name="name">stock.picking.photo.form</field>
        <field name="model">stock.picking.photo</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="picking_id"/>
                        <field name="note"/>
                        <field name="image_1920" widget="image"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_picking_tree_custom_delivery" model="ir.ui.view">
        <field name="name">stock.picking.tree.custom.delivery</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.vpicktree"/>
        <field name="arch" type="xml">
            <xpath expr="//tree/field[@name='state']" position="after">
                <field name="picking_type_id"/>
                <field name="delivery_driver_id"/>
                <field name="delivery_proof_state"/>
                <field name="delivery_signed_by"/>
                <field name="delivery_signed_on"/>
            </xpath>
        </field>
    </record>

    <record id="view_picking_form_custom_barcode_button" model="ir.ui.view">
        <field name="name">stock.picking.form.custom.barcode.button</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_open_custom_barcode" type="object" string="Barcode App" class="oe_highlight"/>
                <button name="action_open_assign_driver_wizard" type="object" string="Assign Driver" attrs="{'invisible': [('picking_type_code', '!=', 'outgoing')]}"/>
                <button name="action_mark_delivery_signed" type="object" string="Mark Signed" attrs="{'invisible': ['|', ('picking_type_code', '!=', 'outgoing'), ('delivery_signature', '=', False)]}"/>
                <button name="action_driver_complete_delivery" type="object" string="Complete Delivery" class="btn-primary" attrs="{'invisible': [('picking_type_code', '!=', 'outgoing')]}"/>
            </xpath>
            <xpath expr="//sheet/notebook" position="inside">
                <page string="Delivery Proof" attrs="{'invisible': [('picking_type_code', '!=', 'outgoing')]}">
                    <group>
                        <group>
                            <field name="delivery_driver_id"/>
                            <field name="delivery_proof_state" readonly="1"/>
                            <field name="delivery_signed_by"/>
                            <field name="delivery_signed_on" readonly="1"/>
                        </group>
                        <group>
                            <field name="delivery_signature" widget="signature"/>
                            <field name="delivery_note"/>
                        </group>
                    </group>
                </page>
                <page string="Barcode Photos">
                    <group>
                        <field name="barcode_photo_ids" readonly="1">
                            <tree>
                                <field name="create_date"/>
                                <field name="product_id"/>
                                <field name="note"/>
                            </tree>
                        </field>
                    </group>
                </page>
                <page string="Driver Photos" attrs="{'invisible': [('picking_type_code', '!=', 'outgoing')]}">
                    <group>
                        <field name="picking_photo_ids" readonly="1">
                            <tree>
                                <field name="create_date"/>
                                <field name="note"/>
                                <field name="image_1920" widget="image"/>
                            </tree>
                        </field>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
