<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_picking_assign_driver_form" model="ir.ui.view">
        <field name="name">stock.picking.assign.driver.form</field>
        <field name="model">stock.picking.assign.driver</field>
        <field name="arch" type="xml">
            <form string="Assign Driver">
                <group>
                    <field name="picking_id" readonly="1"/>
                    <field name="driver_id"/>
                </group>
                <footer>
                    <button name="action_assign" type="object" string="Assign" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
